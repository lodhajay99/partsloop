# ---------------------------------------------------------------------------
# Supabase (required)
# Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed for `npm run db:push` / `db:seed` / `db:reset` / `db:inspect`.
# This is the POSTGRES connection string, NOT the REST API URL above — they sit
# next to each other in the dashboard and are easy to mix up.
# Project Settings -> Database -> Connection string.
# Prefer the Session pooler URI: the direct db.<ref>.supabase.co host is IPv6-only
# on new projects and many networks cannot reach it.
# No connection string to hand? `npm run db:bundle` writes supabase/bundle.sql to
# paste into the SQL editor instead — no password needed.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Razorpay (optional — without these the app runs in labelled simulated mode)
# Use TEST MODE keys only. Dashboard -> Account & Settings -> API Keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret

# Dashboard -> Settings -> Webhooks. Point it at
# https://<your-deployment>/api/razorpay/webhook and subscribe to
# payment.captured and payment_link.paid.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build Razorpay callback URLs. Must match where the app is reachable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform's cut on shop-to-shop trades, in basis points. 200 = 2%.
PLATFORM_FEE_BPS=200

# How long a reservation holds stock before it expires.
RESERVATION_HOLD_MINUTES=30

# Dashboard flags any stock line below this.
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=3
